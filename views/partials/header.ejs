<header class="w-full flex mb-6 justify-between items-center border-b pb-1">
  <a href="/">
    <h2 class="flex gap-x-2 text-2xl font-bold">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M19.876 2.008a1 1 0 1 1 .248 1.984l-7.124 .891v2.117h4.2a1 1 0 0 1 .688 .274l.087 .093c2.79 3.417 2.717 9.963 -.226 13.295a1 1 0 0 1 -.749 .338h-10.106a1 1 0 0 1 -.763 -.353c-2.86 -3.373 -2.86 -9.92 0 -13.294a1 1 0 0 1 .763 -.353h4.106v-1.867l-6.876 .86a1 1 0 0 1 -1.095 -.754l-.021 -.115a1 1 0 0 1 .868 -1.116l7.996 -1l.011 -.001l.008 -.001zm-8.876 6.992h-3.617l-.051 .072c-.718 1.042 -1.149 2.41 -1.292 3.844l-.008 .084h4.968zm5.698 0h-3.698v4h4.979l-.005 -.072c-.123 -1.436 -.533 -2.811 -1.232 -3.864z" /></svg>
      Inventory App
    </h2>
  </a>
  <nav class="flex gap-x-2 justify-end text-nowrap">
    <% if (locals.currentUser) {%>
      <h1 class="text-sm self-center font-semibold text-fuchsia-200"><%= currentUser.username %></h1>
      <a class="bg-red-500 self-center px-2 py-0.5 rounded-md text-nowrap" href="/log-out">LOG OUT</a>
    <% } else { %>
      <a class="bg-green-400 self-center px-2 py-0.5 rounded-md text-nowrap" href="/log-in">LOG IN</a>
      <a class="bg-blue-400 self-center px-2 py-0.5 rounded-md text-nowrap" href="/sign-up">SIGN UP</a>
    <%}%>
  </nav>
</header>
