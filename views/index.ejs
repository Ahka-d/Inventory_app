<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="min-h-screen p-6 bg-gray-900 text-white">
  <%- include('./partials/header') %>
  <div>
    <div class="flex flex-col justify-center items-center">
      <h1 class="text-fuchsia-200 text-3xl font-extrabold"><%= title %></h1>
      <p>Manage your inventory with ease</p>
    </div>
    
    <%- include('./partials/options') %>
    
    <div class="flex flex-col gap-4">
      <% if (locals.items && items.length > 0) {%>
        <ul class="my-12">
          <% items.forEach(function(item) { %>
            <li class="border-b border-gray-700 py-2 bg-gray-800 p-8 flex justify-between items-center">
              <div>
                <a href="/read-product/<%= item.item_id %>">
                  <div class="flex gap-2">
                    <% if (item.item_id) { %>
                    <p class="font-semibold"><%= item.description %></p>
                    <span class="self-center text-sm border rounded-full px-2 bg-green-600/30"><%= item.category %></span>
                    <% } %>
                  </div>
                  <span class="font-semibold text-sm">View Details</span>
                </a>
              </div>
              <% if (locals.currentUser && item.user_id === locals.currentUser.id) { %>
              <div class="flex gap-2">
                <a href="/delete-product/<%= item.item_id %>" class="rounded bg-red-400 px-2 py-1 flex items-center hover:bg-red-500">
                  🗑️ Delete
                </a>
                <a href="/update-product/<%= item.item_id %>" class="rounded bg-blue-400 px-2 py-1 flex items-center hover:bg-blue-500">
                  ✏️ Edit
                </a>
              </div>
              <% } %>
            </li>
          <% }); %>
        </ul>
      <% } else { %>
        <div class="flex flex-col my-10">
          <div class="text-3xl">📦</div>
          <h3 class="font-bold text-fuchsia-200">No Products Found</h3>
          <p class="font-semibold text-sm">The inventory is empty. Start by adding your first product!</p>
        </div>
      <% } %>
    </div>
    
    <% if (locals.items && items.length > 0) { %>
      <div>
        <p>Total products: <strong><%= items.length %></strong></p>
      </div>
    <% } %>
  </div>
</body>
</html>
